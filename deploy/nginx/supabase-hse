server {
    server_name supabase.hse-company.kz;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;

        # Document generation can legitimately exceed the default 60 seconds
        # while Google Apps Script copies templates and embeds photos.
        proxy_connect_timeout 30s;
        proxy_send_timeout 330s;
        proxy_read_timeout 330s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/supabase.hse-company.kz/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/supabase.hse-company.kz/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = supabase.hse-company.kz) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name supabase.hse-company.kz;
    return 404; # managed by Certbot
}
